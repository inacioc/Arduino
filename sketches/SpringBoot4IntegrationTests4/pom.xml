<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>order-management-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Order Management - Multi-module (hexagonal, pragmatic)</name>

    <properties>
        <java.version>17</java.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.46</lombok.version>
        <ibm-mq.version>4.1.0</ibm-mq.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <thymeleaf-layout-dialect.version>3.4.0</thymeleaf-layout-dialect.version>
    </properties>

    <!-- domain + persistence are libraries; each driving/runnable adapter is its
         own executable Spring Boot application (web = REST server, batch = job
         runner, messaging = JMS listener). adapter-events is a library too: the
         Spring Modulith event-publication plumbing, shared by any module that
         needs to publish or consume durable domain events. frontend is deliberately
         NOT one of these hexagon adapters: it is a separate application that only
         ever talks HTTP+JSON to adapter-in-web's REST API and depends on none of
         the modules above - see frontend/pom.xml. -->
    <modules>
        <module>domain</module>
        <module>adapter-out-persistence</module>
        <module>adapter-out-messaging</module>
        <module>adapter-out-batch</module>
        <module>adapter-in-web</module>
        <module>adapter-events</module>
        <module>frontend</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-adapter-in-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-adapter-out-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-adapter-out-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-adapter-out-batch</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>order-adapter-events</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Modulith BOM (2.1.x targets Spring Boot 4.0+/Framework 7) -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Third-party not managed by the Spring Boot BOM -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ibm.mq</groupId>
                <artifactId>mq-jms-spring-boot-starter</artifactId>
                <version>${ibm-mq.version}</version>
            </dependency>
            <dependency>
                <groupId>nz.net.ultraq.thymeleaf</groupId>
                <artifactId>thymeleaf-layout-dialect</artifactId>
                <version>${thymeleaf-layout-dialect.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Inherited by every module: Surefire runs **/*Test.java (fast unit tests),
             Failsafe runs **/*IT.java (integration / slice tests) on `mvn verify`. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
